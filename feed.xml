---
layout: none
permalink: /feed.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'en' }}">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | normalize_whitespace | xml_escape }}</subtitle>
  <id>{{ '/' | absolute_url }}</id>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/>
  <updated>{{ site.posts.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ '/' | absolute_url }}</uri>
  </author>
  {%- for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <id>{{ post.url | absolute_url }}</id>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <link href="{{ post.markdown_url | absolute_url }}" rel="alternate" type="text/markdown"/>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | strip_html | normalize_whitespace | xml_escape }}</summary>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
